# Discord bot token, from the Discord Developer Portal's "Bot" tab
DISCORD_TOKEN=

# Application (client) ID, from the Developer Portal's "General Information" tab
DISCORD_APP_ID=

# Milliseconds to wait in an empty voice channel before auto-disconnecting (default: 30000)
TIMEOUT_DURATION=

# Only needed for local (non-Docker) development. The Docker image bundles a
# yt-dlp binary (see Dockerfile) and needs nothing here; running the bot
# directly on your machine needs yt-dlp installed and on PATH, or this set to
# wherever it lives (https://github.com/yt-dlp/yt-dlp#installation).
YTDLP_PATH=

# Optional. Most videos play fine anonymously, but some (age-restricted, or
# otherwise flagged as needing a real signed-in account) need cookies from a
# logged-in YouTube session - yt-dlp (see src/services/ytSource.ts) picks
# these up automatically when set. Set ONE of:
#
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt   (preferred - see docker-compose.yml;
#                                               the cookie data is usually too
#                                               large to pass as a plain env var)
# YOUTUBE_COOKIES=...                          (fine for short values / local dev)
#
# Either the Netscape cookies.txt format (e.g. via the "Get cookies.txt
# LOCALLY" browser extension - yt-dlp's own recommended way to get these) or
# the EditThisCookie-style JSON array both work; JSON gets converted
# automatically.
YOUTUBE_COOKIES_FILE=
YOUTUBE_COOKIES=

# Optional. SoundCloud playback works out of the box (the client id is
# auto-discovered the same way a browser session picks it up). These are only
# needed to access private tracks tied to a specific account.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_OAUTH_TOKEN=
