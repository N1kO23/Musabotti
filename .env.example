# Discord bot token, from the Discord Developer Portal's "Bot" tab
DISCORD_TOKEN=

# Application (client) ID, from the Developer Portal's "General Information" tab
DISCORD_APP_ID=

# Milliseconds to wait in an empty voice channel before auto-disconnecting (default: 30000)
TIMEOUT_DURATION=

# Optional. Most videos play fine via an anonymous session, but some (age-
# restricted, or otherwise flagged as needing a real signed-in account) will
# still be rejected. Setting this enables a fallback authenticated session
# (see src/services/ytSource.ts) for just those - export cookies from a
# logged-in YouTube session (e.g. via the EditThisCookie browser extension)
# and set ONE of:
#
# YOUTUBE_COOKIES_FILE=/path/to/cookies.json   (preferred - see docker-compose.yml;
#                                                the cookie array is usually too
#                                                large to pass as a plain env var)
# YOUTUBE_COOKIES=[{"name":"...","value":"..."}, ...]   (fine for short values / local dev)
YOUTUBE_COOKIES_FILE=
YOUTUBE_COOKIES=

# Optional. SoundCloud playback works out of the box (the client id is
# auto-discovered the same way a browser session picks it up). These are only
# needed to access private tracks tied to a specific account.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_OAUTH_TOKEN=
